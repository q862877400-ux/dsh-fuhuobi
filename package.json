{
  "name": "dsh-bie-beng",
  "version": "0.1.0",
  "description": "插件别崩！！装个新插件，重启又崩了？报错复制给网页版 DeepSeek 让它修？让老夫代劳吧——装前自动快照、崩了自动回滚、桌面一键救回，还会帮你隔离坏插件、写事故报告。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/q862877400-ux/dsh-bie-beng.git"
  },
  "homepage": "https://github.com/q862877400-ux/dsh-bie-beng",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-guard": "./scripts/guard-cli.js"
  },
  "files": [
    "src",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/smoke-test.js",
    "prepublishOnly": "npm test",
    "desktop-button": "node scripts/install-with-desktop-button.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "rollback",
    "snapshot",
    "guard",
    "插件别崩",
    "dsh插件回滚",
    "dsh插件备份"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-runtime"
      ],
      "immediately": true
    }
  },
  "author": {
    "name": "q862877400-ux",
    "url": "https://github.com/q862877400-ux"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
